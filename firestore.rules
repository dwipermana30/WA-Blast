rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

   
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email == 'dpermana3008@gmail.com';
    }

    function isApproved(uid) {
      return exists(/databases/$(database)/documents/accountRequests/$(uid)) &&
             get(/databases/$(database)/documents/accountRequests/$(uid)).data.status == 'approved';
    }

    // Data pendaftaran akun
    match /accountRequests/{uid} {
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.status == 'pending';


      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // Hanya admin yang boleh mengubah status (menyetujui/menolak)
      allow update, delete: if isAdmin();
    }

    // Data aplikasi (kontak, template pesan) milik tiap pengguna
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
                          && request.auth.uid == uid
                          && (isApproved(uid) || isAdmin());
    }
  }
}
